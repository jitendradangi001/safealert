# Copy this file to .env.local and fill in your Supabase project values.
# These are found in your Supabase project: Settings -> API.
# Only the anon/public key goes in the frontend. NEVER put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
